#!/usr/bin/env bash
set -euo pipefail

: "${PORT:?Amp must provide PORT}"
: "${PUBLIC_URL:?Amp must provide PUBLIC_URL}"
: "${WORKOS_API_KEY:?Add WORKOS_API_KEY as an Amp project secret}"

node --input-type=module <<'EOF'
const origin = new URL(process.env.PUBLIC_URL).origin;
const registrations = [
  {
    label: "callback",
    endpoint: "redirect_uris",
    value: `${origin}/callback`,
    body: { uri: `${origin}/callback` },
  },
  {
    label: "CORS origin",
    endpoint: "cors_origins",
    value: origin,
    body: { origin },
  },
];

for (const registration of registrations) {
  const response = await fetch(
    `https://api.workos.com/user_management/${registration.endpoint}`,
    {
      method: "POST",
      headers: {
        Authorization: `Bearer ${process.env.WORKOS_API_KEY}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(registration.body),
    },
  );

  if (!response.ok) {
    const body = await response.text();
    const alreadyRegistered = response.status === 422 && body.includes("already exists");

    if (!alreadyRegistered) {
      throw new Error(
        `WorkOS rejected the orb ${registration.label} (${response.status}): ${body}`,
      );
    }
  }

  console.log(`WorkOS ${registration.label} ready: ${registration.value}`);
}
EOF

# Vite only exposes VITE_* variables, but it does not need the WorkOS server credential at all.
unset WORKOS_API_KEY

exec vp dev --host 0.0.0.0 --port "$PORT" --strictPort
