#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

vite_plus_version="0.2.8"
export VP_HOME="${VP_HOME:-$HOME/.vite-plus}"
export PATH="$VP_HOME/bin:$PATH"

echo "==> Ensuring Vite+ ${vite_plus_version} is installed"
installed_vite_plus_version="$(vp --version 2>/dev/null || true)"
if [[ "$installed_vite_plus_version" != "vp v${vite_plus_version}"* ]]; then
  time curl -fsSL https://vite.plus | env \
    CI=1 \
    VP_HOME="$VP_HOME" \
    VP_NODE_MANAGER=yes \
    VP_VERSION="$vite_plus_version" \
    bash
fi

echo "==> Installing locked project dependencies"
time vp install --frozen-lockfile

if [[ ! -f .env.local ]]; then
  echo "==> Creating .env.local from .env.example"
  cp -- .env.example .env.local
fi

echo "==> Orb setup complete"
