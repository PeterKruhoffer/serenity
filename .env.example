# Created automatically by `vp run convex:dev` for a configured deployment.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public WorkOS AuthKit browser configuration.
VITE_WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXXXXXXXX
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
# For an Amp portal, register its exact onamp.dev origin as a WorkOS Sign-out URI
# and its /callback URL as a Redirect URI. Shared preview domains may reject wildcards.

# Set these on the Convex deployment, never in the browser bundle:
# WORKOS_CLIENT_ID
# WORKOS_API_KEY
# WORKOS_WEBHOOK_SECRET
